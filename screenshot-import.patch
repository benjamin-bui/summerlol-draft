+  });
+
+  it("reads a typed K/D/A box as a whole number or nothing", () => {
+    expect(parseCount("12")).toBe(12);
+    expect(parseCount("0")).toBe(0);
+    expect(parseCount("")).toBe(null);
+    expect(parseCount("-3")).toBe(null);
