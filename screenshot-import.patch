+    expect(championDisplayName("drmundo")).toBe("Dr. Mundo");
+    expect(championDisplayName("monkeyking")).toBe("Wukong");
+    expect(championDisplayName("nunu")).toBe("Nunu & Willump");
+    expect(championDisplayName("jinx")).toBe("Jinx");
