+  for (const [i, expected] of [[0, "ilove2futtbuck"], [2, "lightningfst"], [3, "kingofconquestlv"], [4, "kalesvol"], [5, "ass fuk"], [6, "yeetor"], [7, "aangelil"], [8, "angusmcrib"], [9, "sk telecom t1"]]) {
+    assert.equal(names[i], expected);
