# Copy to .env and fill in what you need. Every var here is optional --
# the app runs fine with none of them set, just with reduced functionality
# (no live Riot lookups, no admin routes).

# Enables automatic Riot API lookups (rank data, the 14-day resync job).
# Without it, the scheduler logs "RIOT_API_KEY not set" and skips syncing.
RIOT_API_KEY=

# Riot API routing region for account/match lookups (e.g. americas, europe,
# asia). Defaults to "americas" if unset.
RIOT_REGION=americas

# Region used when building op.gg profile links (e.g. na, euw).
OPGG_REGION=na

# Bearer token required by the admin-only routes (uploading roster presets,
# etc). Leave unset to disable those routes entirely.
ADMIN_TOKEN=

# Overrides for where the ingest scripts read their source files from.
# Defaults are under ./data -- only set these if you're pointing at a CSV
# or match-details file that lives somewhere else.
# CSV_PATH=
# MATCH_DETAILS_PATH=

# HTTP port the server listens on.
PORT=3000
