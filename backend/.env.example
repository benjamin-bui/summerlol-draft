# Copy to .env and fill in what you need. Every var here is optional --
# the app runs fine with none of them set, just with reduced functionality
# (no live Riot lookups, no admin routes).

# Enables automatic Riot API lookups (rank data, the 14-day resync job).
# Without it, the scheduler logs "RIOT_API_KEY not set" and skips syncing.
RIOT_API_KEY=

# Riot API routing region for account/match lookups (e.g. americas, europe,
# asia). Defaults to "americas" if unset.
RIOT_REGION=americas

# Region used when building op.gg profile links (e.g. na, euw).
OPGG_REGION=na

# Bearer token required by the admin-only routes (uploading roster presets,
# etc). Leave unset to disable those routes entirely.
ADMIN_TOKEN=

# Overrides for where the ingest scripts read their source files from.
# Defaults are under ./data -- only set these if you're pointing at a CSV
# or match-details file that lives somewhere else.
# CSV_PATH=
# MATCH_DETAILS_PATH=

# HTTP port the server listens on.
PORT=3000

# ---- Editor login (OpenID Connect) -------------------------------------
# Lets approved people sign in and edit match details (champions, K/D/A,
# roles, bans) from the Match History tab. Everyone else, signed in or not,
# is read-only. Leave OIDC_* unset to keep the whole site read-only.
#
# The identity provider can be anything that speaks OIDC (Forgejo, Authentik,
# Keycloak, Google, Auth0...). Register this app there with the redirect URI
#   <PUBLIC_URL>/auth/callback
# and the scopes "openid profile email".
#
# Public address people use to reach this app, no trailing slash. Used to
# build the redirect URI -- it is never taken from request headers.
# PUBLIC_URL=https://draft.example.com
# Provider's issuer URL (must serve /.well-known/openid-configuration).
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# Leave empty only if the provider registered this as a public (PKCE) client.
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
#
# WHO MAY EDIT. Signing in is not enough: a person must match at least one of
# these, otherwise they are turned away and get no session. With none set,
# nobody can edit. Comma-separated; any match is enough.
#   OIDC_EDITOR_SUBS   provider subject ids (most robust; the "sub" claim)
#   OIDC_EDITOR_EMAILS emails -- only counted if the provider marks them verified
#   OIDC_EDITOR_GROUPS group names, read from the claim named below
# OIDC_EDITOR_SUBS=
# OIDC_EDITOR_EMAILS=alice@example.com,bob@example.com
# OIDC_EDITOR_GROUPS=
# OIDC_GROUPS_CLAIM=groups
#
# Hours a sign-in lasts before the editor must sign in again (default 8).
# SESSION_TTL_HOURS=8
#
# Local development against an http:// provider only. Never in production.
# OIDC_ALLOW_INSECURE_HTTP=true
